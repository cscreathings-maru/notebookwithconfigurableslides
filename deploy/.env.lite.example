# =============================================================================
# NotebookLLM-Lite — demo environment (single-tenant, no auth)
# Copy to deploy/.env.lite and fill in, then use docker-compose.lite.yml.
#   cp deploy/.env.lite.example deploy/.env.lite
# =============================================================================

# --- Lite mode switch (backend) -------------------------------------------
# true  = single-tenant demo: no login, no quotas, LLM from OPENROUTER_* below.
# false = full multi-tenant SaaS (OIDC, RBAC, per-tenant BYOK, metering).
LITE_MODE=true

# Fixed default workspace + admin. The backend derives stable ids from these
# (uuid5) and the seed step creates the matching rows. Changing the slug/email
# after seeding creates a NEW empty workspace — pick them once.
DEFAULT_TENANT_SLUG=demo
DEFAULT_TENANT_NAME=Demo Workspace
DEFAULT_USER_EMAIL=demo@local

# --- OpenRouter (the product LLM: chat, guide, outline) --------------------
# Chat-completions only. Get a key at https://openrouter.ai/keys.
# Verify any slug you set actually exists -- an invalid one fails as an opaque 404:
#   curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*deepseek[^"]*"'
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-changeme
# deepseek-v4-pro: 1M context (a whole .docx fits) at a LOWER output price than
# deepseek-chat. Alternatives: deepseek/deepseek-v4-flash (cheapest sensible),
# moonshotai/kimi-k3 (stronger, ~17x the output cost).
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
# Optional: curated model slugs offered in the Studio dropdown (CSV).
# OPENROUTER_MODELS=deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash,moonshotai/kimi-k3

# --- Deck planning per-task model routing (LD-10, PLAN-LLM-DECK-PLANNING.md) --
# Empty means "use OPENROUTER_MODEL above".
#
# AVOID REASONING MODELS FOR CATALOGUING. Measured 2026-08-23:
# moonshotai/kimi-k3 spent its entire 16,000-token output budget on internal
# reasoning (56k characters of it), hit `finish_reason: "length"`, and
# returned `content: null` -- no answer at all. Cataloguing and planning are
# CLASSIFICATION tasks; a reasoning model burns budget thinking about work
# that needs none. Prefer a fast instruction-following model.
#
# Verify any slug exists before relying on it -- an invalid one fails as an
# opaque 404:
#   curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*deepseek[^"]*"'
DECK_CATALOG_MODEL=deepseek/deepseek-v4-pro
DECK_PLAN_MODEL=deepseek/deepseek-v4-pro

# How much slide text goes into ONE cataloguing call, in characters
# (~4 chars/token). The whole template at once was a 21k-token prompt; at
# 6000 the BRI deck splits into 9 small calls, largest ~2k tokens. Lower it
# if a model still runs out of output budget; raise it to trade calls for
# prompt size. Cataloguing is once per template, so more calls cost little.
# DECK_CATALOG_MAX_CHARS_PER_CALL=6000

# --- AI output language ----------------------------------------------------
# Language NAME (not an ISO code) for decks + the guide/chat prompts. Defaults
# target Indonesian users; users can still switch per deck / in the UI.
# DEFAULT_LANGUAGE=Bahasa Indonesia
# LANGUAGES=Bahasa Indonesia,English

# --- Embeddings for Open Notebook (RAG index) -----------------------------
# OpenRouter has NO embeddings endpoint, so document analysis needs a separate
# embeddings provider. OpenAI is the default here. (You can reuse this key or a
# dedicated one.) Confirm/enter these in the Open Notebook UI on first run.
OPENAI_API_KEY=sk-changeme
EMBEDDING_MODEL=text-embedding-3-small

# Document extraction. Open Notebook installs this AT CONTAINER STARTUP and skips it
# unless enabled, so leaving it false means .docx / .pptx / .xlsx cannot be ingested
# at all -- they fail with "unsupported format". .md and .txt work regardless.
# First start after enabling downloads a large ML stack (hundreds of MB to a few GB).
# It lands in /app/.venv, which is NOT on a volume -- recreating the container
# re-downloads it. A plain `restart` keeps it.
OPEN_NOTEBOOK_ENABLE_DOCLING=true
# Only needed for ingesting web URLs; also downloads a ~150MB Chromium.
OPEN_NOTEBOOK_ENABLE_CRAWL4AI=false

# Slide images. pexels (free key) or switch to dall-e-3 / gemini_flash (+ that key).
IMAGE_PROVIDER=pexels
PEXELS_API_KEY=changeme

# --- Orchestrator runtime -------------------------------------------------
ORCH_SECRET_KEY=change-me-long-random    # still used for at-rest crypto helpers
PUBLIC_BASE_URL=http://localhost:8099    # used for OpenRouter HTTP-Referer header
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (system of record) ----------------------------------------
POSTGRES_USER=orch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orchestrator
DATABASE_URL=postgresql+psycopg://orch:change-me@postgres:5432/orchestrator

# --- Redis (queue) --------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- MinIO (object storage for uploads + generated decks) -----------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=presentations
MINIO_ENDPOINT=http://minio:9000

# --- Open Notebook internal store (SurrealDB) -----------------------------
OPEN_NOTEBOOK_URL=http://open-notebook:5055
OPEN_NOTEBOOK_ENCRYPTION_KEY=change-me-secret
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# --- Frontend (baked into the browser bundle at BUILD time) ---------------
# Same-origin API via Traefik, so this stays a relative path.
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_LITE_MODE=true
NEXT_PUBLIC_DEFAULT_TENANT_NAME=Demo Workspace

# NOTE: no OIDC_* / NEXT_PUBLIC_OIDC_* vars are needed in lite mode.
